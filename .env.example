# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://akukulu:akukulu@localhost:5432/akukulu
REDIS_URL=redis://localhost:6379
# Schema sync is convenient in development; disable in production and manage the schema deliberately.
DB_SYNCHRONIZE=true
# At least 32 random characters in production.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# From @BotFather. Used to verify Mini App initData and by the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=akukulu_bot
# Direct Mini App link (BotFather > /newapp), e.g. https://t.me/akukulu_bot/play
TELEGRAM_WEBAPP_LINK=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
# Comma-separated Telegram user ids that get admin access.
ADMIN_TELEGRAM_IDS=
# Daily and referral rewards are paid only after an admin approves them (true by default).
REWARDS_REQUIRE_APPROVAL=true
# Shared secret between the bot and the API's /internal endpoints.
INTERNAL_API_KEY=change-me-internal-key
CORS_ORIGINS=http://localhost:3000
# Development only: lets the web app sign in without Telegram. Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH=false

# ---------- Docker host ports (docker-compose.yml) ----------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---------- Web (apps/web; build-time) ----------
# Leave empty: the web app proxies /api and /socket.io to the API (INTERNAL_API_ORIGIN, default http://localhost:4000),
# so one tunnel or domain serves everything.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEV_AUTH=false

# ---------- Bot (apps/bot) ----------
WEBAPP_URL=https://your-public-web-app-url
API_INTERNAL_URL=http://localhost:4000/api
COMMUNITY_URL=https://t.me/your_community
SUPPORT_URL=https://t.me/your_support
